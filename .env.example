# Copy to .env to override. All values are DEV-ONLY defaults; never reuse them anywhere real.
# Used by docker-compose.yml and by the application (see src/main/resources/application.yml).

DB_NAME=aigateway
DB_USERNAME=aigateway
DB_PASSWORD=aigateway-dev-only
DB_PORT=5433

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev-only
KEYCLOAK_PORT=8180

OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.2:1b
# Point at a native Ollama install instead of the container (much faster on Apple silicon):
# OLLAMA_BASE_URL=http://localhost:11434
